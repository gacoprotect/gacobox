# Provider Configuration
# Copy this file to .env and fill in your values

# Path to provider database (SQLite)
# Windows: C:\Users\{user}\.provider\db\data.sqlite
# Linux/Mac: ~/.provider/db/data.sqlite
PROVIDER_DB_PATH=

# Provider name (default: blackbox)
PROVIDER_NAME=blackbox

# Auth type (default: apikey)
PROVIDER_AUTH_TYPE=apikey

# API base URL
PROVIDER_BASE_URL=https://api.blackbox.ai/v1

# Cloudflare temp-email Worker (see cloudflare_temp_email project)
CF_API_URL=https://your-worker.workers.dev
CF_DEFAULT_DOMAIN=example.com

# Proxy list, one URL per line: http://user:pass@host:port
# Leave the file absent to run without proxies.
PROXY_FILE=proxies.txt

# Cloudflare WARP egress rotation
WARP_CLI=warp-cli
WARP_ROTATE=0
# Accounts each worker signs up before the egress rotates.
# Rotation happens every WARP_CYCLE * workers accounts.
WARP_CYCLE=2
# Random pause per worker when a rotation releases them, so the workers
# do not all hit signup on the same second behind the fresh egress.
WARP_STAGGER_MIN=1.0
WARP_STAGGER_MAX=5.0

# Pause between spawning each account task.
DELAY_MIN=3.0
DELAY_MAX=10.0

# Pause a worker takes after finishing an account.
COOLDOWN_MIN=10.0
COOLDOWN_MAX=20.0

# Verbose per-poll logging. Set 0 for INFO only.
DEBUG=1
